DATABASE_URL=postgresql+asyncpg://pf:pf@localhost:5432/pf
SESSION_SECRET=change-me-to-a-long-random-string
MASTER_ADMIN_EMAIL=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
ENV=local
DEV_AUTH_BYPASS=false
# V5 photo drafts — empty keys boot fine; a missing key only fails at real extraction.
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
UPLOAD_DIR=data/uploads
# V6 email ingestion — empty INGEST_IMAP_HOST keeps the poller fully inert.
INGEST_IMAP_HOST=
INGEST_IMAP_PORT=993
INGEST_IMAP_USER=
INGEST_IMAP_PASSWORD=
INGEST_MAIL_ALIAS=
INGEST_POLL_SECONDS=60
